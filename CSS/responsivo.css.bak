/* PARTE GABI */

@media (max-width: 980px) {
  .grupo-card,
  .linha-tempo ol {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .card-foto > img {
    height: 230px;
  }

  .modal-equipe-conteudo {
    grid-template-columns: 1fr;
  }

  .modal-equipe-foto {
    height: 320px;
  }

  .processo-site-etapas {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }

  .processo-site-etapa {
    min-height: 96px;
    padding: 16px 12px 14px;
  }

  .processo-site-etapa-texto strong {
    font-size: 0.92rem;
  }

  .processo-site-etapa-texto small {
    font-size: 0.78rem;
  }

  .processo-site-painel {
    padding: 28px;
  }
}

@media (max-width: 640px) {
  main {
    width: min(100% - 24px, 1200px);
  }

  .equipe,
  .linha-tempo {
    padding: 36px 0 44px;
  }

  .equipe {
    padding-top: 12px;
  }

  .equipe-conteudo {
    width: 100%;
  }

  .linha-tempo h2 {
    margin-bottom: 28px;
    font-size: 1rem;
  }

  .equipe h2 {
    margin-bottom: 16px;
    font-size: 1.45rem;
  }

  .grupo-card,
  .linha-tempo ol {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .card-equipe {
    max-width: 250px;
  }

  .card-foto > img {
    height: 220px;
  }

  .card-base {
    padding: 36px 16px 16px;
  }

  .modal-equipe-conteudo {
    padding: 18px;
    gap: 18px;
  }

  .modal-equipe-foto {
    height: 260px;
  }

  .modal-equipe-texto h3 {
    font-size: 1.4rem;
  }

  .linha-tempo article {
    min-height: auto;
    padding: 28px 18px;
  }

  .linha-tempo header strong {
    font-size: 2.4rem;
  }

  .processo-site {
    padding: 36px 0 44px;
  }

  .processo-site-cabecalho {
    margin-bottom: 28px;
  }

  .processo-site h2 {
    margin-bottom: 16px;
    font-size: 1.45rem;
  }

  .processo-site-subtitulo {
    font-size: 0.96rem;
    line-height: 1.6;
  }

  .processo-site-trilha {
    display: none;
  }

  .processo-site-etapas {
    grid-template-columns: 1fr;
    gap: 14px;
    margin-bottom: 20px;
  }

  .processo-site-etapa {
    min-height: auto;
    padding: 16px;
    border-radius: 20px;
  }

  .processo-site-painel {
    padding: 22px 18px;
    border-radius: 22px;
  }

  .processo-site-painel-topo {
    align-items: flex-start;
  }

  .processo-site-painel-numero {
    width: 50px;
    height: 50px;
    border-radius: 16px;
    font-size: 1rem;
  }

  .processo-site-painel-titulo {
    font-size: 1.35rem;
  }
}
